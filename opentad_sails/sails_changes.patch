@@ -0,0 +1,82 @@
+"""
+SAILS RMM Dataset Config - V-JEPA Balanced Features - Fold 0
+
+Uses V-JEPA2 features extracted from the balanced (4-class) model.
+Feature shape: (T, 1024) where T varies by video length.
+"""
+
+dataset_type = "ThumosPaddingDataset"
+annotation_path = "data/sails_rmm/annotations/fold0_anno.json"
+class_map = "data/sails_rmm/annotations/category_idx.txt"
+data_path = "/orcd/data/satra/002/projects/SAILS/rmm/features/vjepa2_tal_cv_5class_balanced_fold_0/"
+
+# Max sequence length (based on longest video at ~4min @ 2fps = ~480 frames)
+# Set conservatively to handle longer videos
+trunc_len = 2048  # Must be divisible by fpn_stride * window_size (18)
+
+dataset = dict(
+    train=dict(
+        type=dataset_type,
+        ann_file=annotation_path,
+        subset_name="training",
+        class_map=class_map,
+        data_path=data_path,
+        filter_gt=False,
+        # V-JEPA features: 16 frames per snippet @ 30fps = 0.533s per feature
+        # feature_stride relates to how many original frames each feature represents
+        feature_stride=16,
+        sample_stride=1,
+        offset_frames=8,  # Center of 16-frame window
+        pipeline=[
+            dict(type="LoadFeats", feat_format="npy"),
+            dict(type="ConvertToTensor", keys=["feats", "gt_segments", "gt_labels"]),
+            dict(type="RandomTrunc", trunc_len=trunc_len, trunc_thresh=0.5, crop_ratio=[0.9, 1.0]),
+            dict(type="Rearrange", keys=["feats"], ops="t c -> c t"),
+            dict(type="Collect", inputs="feats", keys=["masks", "gt_segments", "gt_labels"]),
+        ],
+    ),
+    val=dict(
+        type=dataset_type,
+        ann_file=annotation_path,
+        subset_name="validation",
+        class_map=class_map,
+        data_path=data_path,
+        filter_gt=False,
+        feature_stride=16,
+        sample_stride=1,
+        offset_frames=8,
+        pipeline=[
+            dict(type="LoadFeats", feat_format="npy"),
+            dict(type="ConvertToTensor", keys=["feats", "gt_segments", "gt_labels"]),
+            dict(type="Rearrange", keys=["feats"], ops="t c -> c t"),
+            dict(type="Collect", inputs="feats", keys=["masks", "gt_segments", "gt_labels"]),
+        ],
+    ),
+    test=dict(
+        type=dataset_type,
+        ann_file=annotation_path,
+        subset_name="validation",
+        class_map=class_map,
+        data_path=data_path,
+        filter_gt=False,
+        test_mode=True,
+        feature_stride=16,
+        sample_stride=1,
+        offset_frames=8,
+        pipeline=[
+            dict(type="LoadFeats", feat_format="npy"),
+            dict(type="ConvertToTensor", keys=["feats"]),
+            dict(type="Rearrange", keys=["feats"], ops="t c -> c t"),
+            dict(type="Collect", inputs="feats", keys=["masks"]),
+        ],
+    ),
+)
+
+evaluation = dict(
+    type="mAP",
+    subset="validation",
+    tiou_thresholds=[0.3, 0.4, 0.5, 0.6, 0.7],
+    ground_truth_filename=annotation_path,
+)
+
+
