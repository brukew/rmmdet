+#SBATCH --partition=ou_bcs_low
+#SBATCH --gres=gpu:1
+#SBATCH --cpus-per-task=4
+#SBATCH --mem=32G
+
+# Re-run E2E post-processing with multiclass=False NMS.
+# Loads raw predictions from id99, saves result to id98.
+#
+# Usage:
+#   for model in actionformer tridet; do
+#     for fold in 0 1 2; do
+#       sbatch slurm/test_e2e_nomc_cv.sh $model balanced $fold
+#     done
+#   done
+
+# --- Portable repo-root resolution (auto-inserted) --------------------------
+# Locate the repo root (the directory containing paths.py) so this script runs
+# from any clone name/location, under `bash` or `sbatch`. SLURM copies the
+# script to a spool dir, so if the script path does not resolve we fall back to
+# $SLURM_SUBMIT_DIR then $PWD. Override by exporting REPO_ROOT before launch.
+_rmm_find_root() {
+  local d="$1"
+  while [ -n "$d" ] && [ "$d" != "/" ]; do
+    if [ -f "$d/paths.py" ]; then printf '%s\n' "$d"; return 0; fi
+    d="$(dirname "$d")"
+  done
+  return 1
+}
+if [ -z "${REPO_ROOT:-}" ] || [ ! -f "${REPO_ROOT:-x}/paths.py" ]; then
+  REPO_ROOT="$(_rmm_find_root "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")" 2>/dev/null && pwd)")" \
+    || REPO_ROOT="$(_rmm_find_root "${SLURM_SUBMIT_DIR:-$PWD}")" \
+    || REPO_ROOT="$(_rmm_find_root "$PWD")" || true
+fi
+if [ -z "${REPO_ROOT:-}" ] || [ ! -f "${REPO_ROOT}/paths.py" ]; then
+  echo "ERROR: cannot locate repo root (paths.py). cd to the repo or export REPO_ROOT." >&2
+  exit 1
+fi
+export REPO_ROOT
+# --- end repo-root resolution ----------------------------------------------
+
+set -e
+
+MODEL=${1:-actionformer}
+TASK=${2:-balanced}
+FOLD=${3:-0}
+
+echo "=============================================="
+echo "E2E Re-NMS: multiclass=False"
+echo "=============================================="
+echo "Model: $MODEL  Task: $TASK  Fold: $FOLD"
+echo "Job ID: ${SLURM_JOB_ID:-local}  Node: $(hostname)  $(date)"
+echo "=============================================="
+
+cd ${REPO_ROOT}/OpenTAD
+
+source ~/miniconda3/etc/profile.d/conda.sh
+conda activate opentad
+
+mkdir -p slurm-logs
+
+CONFIG="configs/${MODEL}/sails_rmm_vjepa_${TASK}_fold${FOLD}.py"
+
+if [ ! -f "$CONFIG" ]; then
+    echo "ERROR: Config file not found: $CONFIG"
+    exit 1
+fi
+
+WORK_DIR="exps/sails_rmm/${MODEL}_vjepa_${TASK}_fold${FOLD}"
+CKPT="${WORK_DIR}/gpu1_id0/checkpoint/best.pth"
+
+echo "Config: $CONFIG"
+echo "Loading raw predictions from: ${WORK_DIR}/gpu1_id98/outputs/ (symlink to id99)"
+echo ""
+
+torchrun --standalone --nproc_per_node=1 \
+    tools/test.py \
+    "$CONFIG" \
+    --checkpoint "$CKPT" \
+    --id 98 \
+    --cfg-options \
+        inference.load_from_raw_predictions=True \
+        inference.save_raw_prediction=False \
+        post_processing.nms.multiclass=False \
+        post_processing.save_dict=True
+
+echo ""
+echo "Test complete!"
+echo "Results: ${WORK_DIR}/gpu1_id98/result_detection.json"
