index 0000000..66a337d
--- /dev/null
+++ b/configs/actionformer/sails_rmm_vjepa_balanced_fold1.py
@@ -0,0 +1,63 @@
+"""
+ActionFormer config for SAILS RMM - V-JEPA Balanced Features - Fold 1
+
+4-class classification: hands flapping, jumping, rocking, spinning
+"""
+
+_base_ = [
+    "../_base_/datasets/sails_rmm/features_vjepa_balanced_fold1.py",
+    "../_base_/models/actionformer.py",
+]
+
+model = dict(
+    projection=dict(
+        in_channels=1024,
+        out_channels=512,
+        input_pdrop=0.2,
+        max_seq_len=2048,  # Must be divisible by max fpn stride (32)
+        attn_cfg=dict(n_head=4, n_mha_win_size=-1),  # Disable windowed attention
+    ),
+    rpn_head=dict(
+        num_classes=4,
+        prior_generator=dict(
+            regression_range=[(0, 4), (4, 8), (8, 16), (16, 32), (32, 64), (64, 10000)],
+        ),
+    ),
+)
+
+solver = dict(
+    train=dict(batch_size=2, num_workers=2),
+    val=dict(batch_size=1, num_workers=1),
+    test=dict(batch_size=1, num_workers=1),
+    clip_grad_norm=1,
+    ema=True,
+)
+
+optimizer = dict(type="AdamW", lr=1e-4, weight_decay=0.05, paramwise=True)
+scheduler = dict(type="LinearWarmupCosineAnnealingLR", warmup_epoch=5, max_epoch=50)
+
+inference = dict(load_from_raw_predictions=False, save_raw_prediction=True)
+post_processing = dict(
+    nms=dict(
+        use_soft_nms=True,
+        sigma=0.5,
+        max_seg_num=200,
+        iou_threshold=0.1,
+        min_score=0.001,
+        multiclass=True,
+        voting_thresh=0.7,
+    ),
+    save_dict=False,
+)
+
+workflow = dict(
+    logging_interval=20,
+    checkpoint_interval=5,
+    val_loss_interval=1,
+    val_eval_interval=1,
+    val_start_epoch=20,
+)
+
+work_dir = "exps/sails_rmm/actionformer_vjepa_balanced_fold1"
+
+
