+++ b/slurm/test_actionformer_cv.sh
@@ -0,0 +1,95 @@
+#!/bin/bash
+#SBATCH --job-name=af_test
+#SBATCH --output=slurm-logs/test_af_%j.out
+#SBATCH --error=slurm-logs/test_af_%j.err
+#SBATCH --time=00:30:00
+#SBATCH --partition=ou_bcs_low
+#SBATCH --gres=gpu:1
+#SBATCH --cpus-per-task=4
+#SBATCH --mem=32G
+
+# Generate result_detection.json from an ActionFormer best checkpoint.
+# Submit from the repo root (so slurm-logs/ resolves next to paths.py):
+#   sbatch OpenTAD/slurm/test_actionformer_cv.sh binary 0
+#   sbatch OpenTAD/slurm/test_actionformer_cv.sh balanced 0
+#
+# Args: <task> <fold>   task in {binary,balanced}  (NOT "4class" — that name
+# is only used by convert_cv_splits_to_opentad_json.py; see that script's README).
+#
+# Writes ${WORK_DIR}/gpu1_id99/result_detection.json (overwrites). Two-stage
+# Stage-1 reads the ActionFormer *binary* id99 JSON.
+
+# --- Portable repo-root resolution (auto-inserted) --------------------------
+# Locate the repo root (the directory containing paths.py) so this script runs
+# from any clone name/location, under `bash` or `sbatch`. SLURM copies the
+# script to a spool dir, so if the script path does not resolve we fall back to
+# $SLURM_SUBMIT_DIR then $PWD. Override by exporting REPO_ROOT before launch.
+_rmm_find_root() {
+  local d="$1"
+  while [ -n "$d" ] && [ "$d" != "/" ]; do
+    if [ -f "$d/paths.py" ]; then printf '%s\n' "$d"; return 0; fi
+    d="$(dirname "$d")"
+  done
+  return 1
+}
+if [ -z "${REPO_ROOT:-}" ] || [ ! -f "${REPO_ROOT:-x}/paths.py" ]; then
+  REPO_ROOT="$(_rmm_find_root "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")" 2>/dev/null && pwd)")" \
+    || REPO_ROOT="$(_rmm_find_root "${SLURM_SUBMIT_DIR:-$PWD}")" \
+    || REPO_ROOT="$(_rmm_find_root "$PWD")" || true
+fi
+if [ -z "${REPO_ROOT:-}" ] || [ ! -f "${REPO_ROOT}/paths.py" ]; then
+  echo "ERROR: cannot locate repo root (paths.py). cd to the repo or export REPO_ROOT." >&2
+  exit 1
+fi
+export REPO_ROOT
+# --- end repo-root resolution ----------------------------------------------
+
+set -e
+
+TASK=${1:-binary}
+FOLD=${2:-0}
+
+echo "=============================================="
+echo "ActionFormer Test (generate result_detection.json)"
+echo "=============================================="
+echo "Task: $TASK  Fold: $FOLD"
+echo "Job ID: ${SLURM_JOB_ID:-local}  Node: $(hostname)  $(date)"
+echo "=============================================="
+
+cd ${REPO_ROOT}/OpenTAD
+
+source ~/miniconda3/etc/profile.d/conda.sh
+conda activate opentad
+
+mkdir -p slurm-logs
+
+CONFIG="configs/actionformer/sails_rmm_vjepa_${TASK}_fold${FOLD}.py"
+
+if [ ! -f "$CONFIG" ]; then
+    echo "ERROR: Config file not found: $CONFIG"
+    exit 1
+fi
+
+WORK_DIR="exps/sails_rmm/actionformer_vjepa_${TASK}_fold${FOLD}"
+CKPT="${WORK_DIR}/gpu1_id0/checkpoint/best.pth"
+
+if [ ! -f "$CKPT" ]; then
+    echo "ERROR: Checkpoint not found: $CKPT"
+    echo "Overlay the shared checkpoint copy first (see REPRODUCE.md)."
+    exit 1
+fi
+
+echo "Config: $CONFIG"
+echo "Checkpoint: $CKPT"
+echo ""
+
+torchrun --standalone --nproc_per_node=1 \
+    tools/test.py \
+    "$CONFIG" \
+    --checkpoint "$CKPT" \
+    --id 99 \
+    --cfg-options post_processing.save_dict=True
+
+echo ""
+echo "Test complete!"
+echo "Results: ${WORK_DIR}/gpu1_id99/result_detection.json"
