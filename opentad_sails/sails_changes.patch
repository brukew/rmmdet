+#SBATCH --partition=pi_satra
+#SBATCH --gres=gpu:1
+#SBATCH --cpus-per-task=4
+#SBATCH --mem=32G
+
+# =============================================================================
+# ActionFormer Training Script for SAILS RMM
+#
+# Usage:
+#   # Train single fold:
+#   sbatch train_actionformer_cv.sh balanced 0
+#
+#   # Train all balanced folds:
+#   for fold in 0 1 2; do sbatch train_actionformer_cv.sh balanced $fold; done
+#
+#   # Train all binary folds:
+#   for fold in 0 1 2; do sbatch train_actionformer_cv.sh binary $fold; done
+# =============================================================================
+
+set -e
+
+# Parse arguments
+TASK=${1:-balanced}  # balanced or binary
+FOLD=${2:-0}
+
+echo "=============================================="
+echo "ActionFormer Training"
+echo "=============================================="
+echo "Task: $TASK"
+echo "Fold: $FOLD"
+echo "=============================================="
+
+# Change to OpenTAD directory
+cd /orcd/data/satra/001/users/brukew/actreg/OpenTAD
+
+# Activate conda environment
+source ~/miniconda3/etc/profile.d/conda.sh
+conda activate opentad
+
+# Create log directory
+mkdir -p slurm_logs
+
+# Select config based on task and fold
+CONFIG="configs/actionformer/sails_rmm_vjepa_${TASK}_fold${FOLD}.py"
+
+if [ ! -f "$CONFIG" ]; then
+    echo "ERROR: Config file not found: $CONFIG"
+    exit 1
+fi
+
+echo "Config: $CONFIG"
+echo ""
+
+# Check if features exist
+if [ "$TASK" == "balanced" ]; then
+    FEAT_DIR="data/sails_rmm/features/vjepa_balanced_fold${FOLD}"
+else
+    FEAT_DIR="data/sails_rmm/features/vjepa_binary_fold${FOLD}"
+fi
+
+if [ ! -d "$FEAT_DIR" ]; then
+    echo "WARNING: Feature directory not found: $FEAT_DIR"
+    echo "Feature extraction may not be complete yet."
+fi
+
+# Run training with torchrun for DDP support
+torchrun --standalone --nproc_per_node=1 \
+    tools/train.py \
+    "$CONFIG" \
+    --seed 42
+
+echo ""
+echo "Training complete!"
+echo "Results saved to: exps/sails_rmm/actionformer_vjepa_${TASK}_fold${FOLD}"
+
+
