+++ b/tools/prepare_data/sails_rmm/convert_cv_splits_to_opentad_json.py
@@ -0,0 +1,325 @@
+#!/usr/bin/env python3
+"""
+Convert SAILS RMM CV splits to OpenTAD annotation format.
+
+Creates ActivityNet-style JSON annotation files for ActionFormer training.
+
+Usage:
+    # Generate 4-class annotation for fold 2
+    python convert_cv_splits_to_opentad_json.py --fold 2 --task 4class
+    
+    # Generate binary annotation for all folds
+    python convert_cv_splits_to_opentad_json.py --fold 0 --task binary
+    python convert_cv_splits_to_opentad_json.py --fold 1 --task binary
+    python convert_cv_splits_to_opentad_json.py --fold 2 --task binary
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from collections import defaultdict
+from pathlib import Path
+from typing import Dict, List, Optional
+
+import pandas as pd
+
+
+# =============================================================================
+# Configuration
+# =============================================================================
+
+# Resolve the repo root (the directory containing paths.py) so this runs from any
+# clone location/name. Falls back to the fixed submodule depth if paths.py is not
+# found (e.g. OpenTAD checked out standalone, outside the parent repo).
+try:
+    _REPO_ROOT = next(
+        p for p in Path(__file__).resolve().parents if (p / "paths.py").exists()
+    )
+except StopIteration:
+    _REPO_ROOT = Path(__file__).resolve().parents[4]
+DATAPREP_DIR = _REPO_ROOT / "dataprep"
+OUTPUT_DIR = _REPO_ROOT / "OpenTAD" / "data" / "sails_rmm" / "annotations"
+
+# Label mappings
+LABEL_MAP_4CLASS = {
+    "hands flapping": "hands flapping",
+    "one hand flap": "hands flapping",  # Map one hand flap to hands flapping
+    "jumping": "jumping",
+    "rocking": "rocking",
+    "spinning": "spinning",
+}
+
+# For binary: merge all RMM types to "rmm"
+LABEL_MAP_BINARY = {
+    "hands flapping": "rmm",
+    "one hand flap": "rmm",  # Include one hand flap in binary
+    "jumping": "rmm",
+    "rocking": "rmm",
+    "spinning": "rmm",
+}
+
+# RMM types to include
+RMM_TYPES_4CLASS = {"hands flapping", "one hand flap", "jumping", "rocking", "spinning"}
+
+
+# =============================================================================
+# Data Loading
+# =============================================================================
+
+def load_rmm_segments(dataprep_dir: Path = DATAPREP_DIR) -> pd.DataFrame:
+    """
+    Load RMM segment annotations.
+    
+    Returns DataFrame with columns: segment_id, child_id, video_file, filename,
+                                     rmm_type, start_sec, end_sec, video_duration
+    """
+    csv_path = dataprep_dir / "rmm_segments.csv"
+    if not csv_path.exists():
+        raise FileNotFoundError(f"RMM segments CSV not found: {csv_path}")
+    
+    df = pd.read_csv(csv_path)
+    
+    # Filter to 4-class RMM types
+    df = df[df["rmm_type"].isin(RMM_TYPES_4CLASS)].copy()
+    
+    # Add filename_stem for video_name construction
+    df["filename_stem"] = df["filename"].apply(lambda x: Path(x).stem)
+    
+    return df
+
+
+def load_video_to_split(
+    dataprep_dir: Path = DATAPREP_DIR,
+    task: str = "4class",
+) -> pd.DataFrame:
+    """
+    Load video-to-fold split mapping.
+    
+    Returns DataFrame with columns: video_key, child_id, filename, video_duration,
+                                     fold_0_split, fold_1_split, fold_2_split
+    """
+    # Binary task uses the same splits as 4class
+    split_task = "4class" if task == "binary" else task
+    csv_path = dataprep_dir / "tal" / "video_assignment" / f"video_to_split_{split_task}_cv.csv"
+    if not csv_path.exists():
+        raise FileNotFoundError(f"Video split CSV not found: {csv_path}")
+    
+    df = pd.read_csv(csv_path)
+    
+    # Add filename_stem for video_name construction
+    df["filename_stem"] = df["filename"].apply(lambda x: Path(x).stem)
+    
+    return df
+
+
+# =============================================================================
+# Annotation Generation
+# =============================================================================
+
+def create_opentad_annotation(
+    segments_df: pd.DataFrame,
+    video_df: pd.DataFrame,
+    fold: int,
+    task: str = "4class",
+) -> Dict:
+    """
+    Create OpenTAD-compatible annotation JSON.
+    
+    Args:
+        segments_df: RMM segment annotations.
+        video_df: Video-to-fold split mapping.
+        fold: CV fold index (0, 1, or 2).
+        task: "4class" or "binary".
+    
+    Returns:
+        Dict in ActivityNet annotation format.
+    """
+    split_col = f"fold_{fold}_split"
+    
+    if split_col not in video_df.columns:
+        raise ValueError(f"Fold {fold} split column not found in video_df")
+    
+    # Select label map based on task
+    if task == "4class":
+        label_map = LABEL_MAP_4CLASS
+    elif task == "binary":
+        label_map = LABEL_MAP_BINARY
+    else:
+        raise ValueError(f"Unknown task: {task}")
+    
+    # Build video name to info mapping
+    video_info = {}
+    for _, row in video_df.iterrows():
+        # video_name format: {child_id}_{filename_stem}
+        video_name = f"{row['child_id']}_{row['filename_stem']}"
+        video_info[video_name] = {
+            "video_key": row["video_key"],
+            "child_id": row["child_id"],
+            "duration": row["video_duration"],
+            "split": row[split_col],
+        }
+    
+    # Build annotations by video
+    annotations_by_video = defaultdict(list)
+    for _, row in segments_df.iterrows():
+        video_name = f"{row['child_id']}_{row['filename_stem']}"
+        
+        if video_name not in video_info:
+            continue
+        
+        rmm_type = row["rmm_type"]
+        if rmm_type not in label_map:
+            continue
+        
+        label = label_map[rmm_type]
+        
+        # Get segment times (half-open interval as per metadata)
+        start_sec = float(row["start_sec"])
+        end_sec = float(row["end_sec"]) + 1.0  # Convert to half-open
+        
+        annotations_by_video[video_name].append({
+            "segment": [start_sec, end_sec],
+            "label": label,
+        })
+    
+    # Build final database dict
+    database = {}
+    for video_name, info in video_info.items():
+        split = info["split"]
+        
+        # Map split to OpenTAD subset name
+        if split == "train":
+            subset = "training"
+        elif split == "val":
+            subset = "validation"
+        else:
+            subset = "testing"
+        
+        # Estimate frame count (assume 30 fps)
+        fps = 30.0
+        frame_count = int(info["duration"] * fps)
+        
+        database[video_name] = {
+            "subset": subset,
+            "duration": info["duration"],
+            "frame": frame_count,
+            "annotations": annotations_by_video.get(video_name, []),
+        }
+    
+    return {"database": database}
+
+
+def create_category_idx(task: str = "4class") -> str:
+    """
+    Create category index file content.
+    
+    Args:
+        task: "4class" or "binary".
+    
+    Returns:
+        String with one category per line.
+    """
+    if task == "4class":
+        categories = ["hands flapping", "jumping", "rocking", "spinning"]
+    elif task == "binary":
+        categories = ["rmm"]
+    else:
+        raise ValueError(f"Unknown task: {task}")
+    
+    return "\n".join(categories) + "\n"
+
+
+# =============================================================================
+# Main
+# =============================================================================
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Convert SAILS RMM CV splits to OpenTAD annotation format."
+    )
+    
+    parser.add_argument(
+        "--fold",
+        type=int,
+        required=True,
+        help="CV fold index (0, 1, or 2).",
+    )
+    parser.add_argument(
+        "--task",
+        choices=["4class", "binary"],
+        default="4class",
+        help="Task type: 4class (4 RMM types) or binary (RMM vs BG).",
+    )
+    parser.add_argument(
+        "--output-dir",
+        type=Path,
+        default=OUTPUT_DIR,
+        help="Output directory for annotation files.",
+    )
+    parser.add_argument(
+        "--dataprep-dir",
+        type=Path,
+        default=DATAPREP_DIR,
+        help="Directory containing data preparation files.",
+    )
+    
+    args = parser.parse_args()
+    
+    print("=" * 60)
+    print("SAILS RMM to OpenTAD Annotation Conversion")
+    print("=" * 60)
+    print(f"Fold: {args.fold}")
+    print(f"Task: {args.task}")
+    print(f"Output dir: {args.output_dir}")
+    
+    # Load data
+    print("\nLoading data...")
+    segments_df = load_rmm_segments(args.dataprep_dir)
+    print(f"  Loaded {len(segments_df)} RMM segments")
+    
+    video_df = load_video_to_split(args.dataprep_dir, args.task)
+    print(f"  Loaded {len(video_df)} videos")
+    
+    # Create annotation
+    print("\nCreating annotation...")
+    annotation = create_opentad_annotation(
+        segments_df=segments_df,
+        video_df=video_df,
+        fold=args.fold,
+        task=args.task,
+    )
+    
+    n_videos = len(annotation["database"])
+    n_train = sum(1 for v in annotation["database"].values() if v["subset"] == "training")
+    n_val = sum(1 for v in annotation["database"].values() if v["subset"] == "validation")
+    n_segments = sum(len(v["annotations"]) for v in annotation["database"].values())
+    
+    print(f"  Total videos: {n_videos}")
+    print(f"  Training videos: {n_train}")
+    print(f"  Validation videos: {n_val}")
+    print(f"  Total annotations: {n_segments}")
+    
+    # Save annotation
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    
+    if args.task == "4class":
+        output_file = args.output_dir / f"fold{args.fold}_anno.json"
+    else:
+        output_file = args.output_dir / f"fold{args.fold}_anno_{args.task}.json"
+    
+    with output_file.open("w", encoding="utf-8") as f:
+        json.dump(annotation, f, indent=2)
+    
+    print(f"\nSaved annotation to: {output_file}")
+    
+    # Save category index
+    category_file = args.output_dir / f"category_idx{'_' + args.task if args.task != '4class' else ''}.txt"
+    category_file.write_text(create_category_idx(args.task))
+    print(f"Saved category index to: {category_file}")
+    
+    print("\nDone!")
+
+
+if __name__ == "__main__":
+    main()
