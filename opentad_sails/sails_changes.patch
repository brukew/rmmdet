+#   # Train single fold:
+#   sbatch train_actionformer_cv.sh balanced 0
+#
+#   # Train all balanced folds:
+#   for fold in 0 1 2; do sbatch train_actionformer_cv.sh balanced $fold; done
+#
+#   # Train all binary folds:
+#   for fold in 0 1 2; do sbatch train_actionformer_cv.sh binary $fold; done
+# =============================================================================
+
+# --- Portable repo-root resolution (auto-inserted) --------------------------
+# Locate the repo root (the directory containing paths.py) so this script runs
+# from any clone name/location, under `bash` or `sbatch`. SLURM copies the
+# script to a spool dir, so if the script path does not resolve we fall back to
+# $SLURM_SUBMIT_DIR then $PWD. Override by exporting REPO_ROOT before launch.
+_rmm_find_root() {
+  local d="$1"
+  while [ -n "$d" ] && [ "$d" != "/" ]; do
+    if [ -f "$d/paths.py" ]; then printf '%s\n' "$d"; return 0; fi
+    d="$(dirname "$d")"
+  done
+  return 1
+}
+if [ -z "${REPO_ROOT:-}" ] || [ ! -f "${REPO_ROOT:-x}/paths.py" ]; then
+  REPO_ROOT="$(_rmm_find_root "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")" 2>/dev/null && pwd)")" \
+    || REPO_ROOT="$(_rmm_find_root "${SLURM_SUBMIT_DIR:-$PWD}")" \
+    || REPO_ROOT="$(_rmm_find_root "$PWD")" || true
+fi
+if [ -z "${REPO_ROOT:-}" ] || [ ! -f "${REPO_ROOT}/paths.py" ]; then
+  echo "ERROR: cannot locate repo root (paths.py). cd to the repo or export REPO_ROOT." >&2
+  exit 1
+fi
+export REPO_ROOT
+# --- end repo-root resolution ----------------------------------------------
+
+set -e
+
+# Parse arguments
+TASK=${1:-balanced}  # balanced or binary
+FOLD=${2:-0}
+
+echo "=============================================="
+echo "ActionFormer Training"
+echo "=============================================="
+echo "Task: $TASK"
+echo "Fold: $FOLD"
+echo "=============================================="
+
+# Change to OpenTAD directory
+cd ${REPO_ROOT}/OpenTAD
+
+# Activate conda environment
+source ~/miniconda3/etc/profile.d/conda.sh
+conda activate opentad
+
+# Create log directory
+mkdir -p slurm-logs
+
+# Select config based on task and fold
+CONFIG="configs/actionformer/sails_rmm_vjepa_${TASK}_fold${FOLD}.py"
+
+if [ ! -f "$CONFIG" ]; then
+    echo "ERROR: Config file not found: $CONFIG"
+    exit 1
+fi
+
+echo "Config: $CONFIG"
+echo ""
+
+# Check if features exist
+if [ "$TASK" == "balanced" ]; then
+    FEAT_DIR="data/sails_rmm/features/vjepa_balanced_fold${FOLD}"
+else
+    FEAT_DIR="data/sails_rmm/features/vjepa_binary_fold${FOLD}"
+fi
+
+if [ ! -d "$FEAT_DIR" ]; then
+    echo "WARNING: Feature directory not found: $FEAT_DIR"
+    echo "Feature extraction may not be complete yet."
+fi
+
+# Run training with torchrun for DDP support
+torchrun --standalone --nproc_per_node=1 \
+    tools/train.py \
+    "$CONFIG" \
+    --seed 42
+
+echo ""
+echo "Training complete!"
+echo "Results saved to: exps/sails_rmm/actionformer_vjepa_${TASK}_fold${FOLD}"
+
+
